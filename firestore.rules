rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null
        && request.auth.token.email_verified == true;
    }

    function getUserData() {
      return get(
        /databases/$(database)/documents/usuarios/$(request.auth.uid)
      ).data;
    }

    function isProvincial() {
      return signedIn() && getUserData().rol == 'PROVINCIAL';
    }

    function isRecinto() {
      return signedIn() && getUserData().rol == 'RECINTO';
    }

    function isVeedor() {
      return signedIn() && getUserData().rol == 'VEEDOR';
    }

    function jrvPath(jrvId) {
      return /databases/$(database)/documents/jrvs/$(jrvId);
    }

    function usuarioPath(uid) {
      return /databases/$(database)/documents/usuarios/$(uid);
    }

    function isVeedorOfRecinto(uid, recintoId) {
      return existsAfter(usuarioPath(uid))
        && getAfter(usuarioPath(uid)).data.rol == 'VEEDOR'
        && getAfter(usuarioPath(uid)).data.recintoId == recintoId;
    }

    function isAssignedVeedor(jrvId) {
      return isVeedor()
        && exists(jrvPath(jrvId))
        && get(jrvPath(jrvId)).data.veedorId == request.auth.uid;
    }

    function canCreateCedulaLookup(cedula) {
      return request.resource.data.keys().hasAll(['email', 'uid'])
        && request.resource.data.keys().hasOnly(['email', 'uid'])
        && request.resource.data.email is string
        && request.resource.data.uid is string
        && existsAfter(usuarioPath(request.resource.data.uid))
        && getAfter(usuarioPath(request.resource.data.uid)).data.id
          == request.resource.data.uid
        && getAfter(usuarioPath(request.resource.data.uid)).data.cedula == cedula
        && getAfter(usuarioPath(request.resource.data.uid)).data.email
          == request.resource.data.email
        && getAfter(usuarioPath(request.resource.data.uid)).data.debeCambiarClave
          == true
        && ((isProvincial()
            && getAfter(usuarioPath(request.resource.data.uid)).data.rol == 'RECINTO')
          || (isRecinto()
            && getAfter(usuarioPath(request.resource.data.uid)).data.rol == 'VEEDOR'
            && getAfter(usuarioPath(request.resource.data.uid)).data.recintoId
              == getUserData().get('recintoId', null)));
    }

    function canReadActaInRecinto(data) {
      return isRecinto()
        && data.recintoId == getUserData().get('recintoId', null);
    }

    function canReadActaAsVeedor(data) {
      return isAssignedVeedor(data.jrvId);
    }

    function isUnlockedActa(data) {
      return (!data.keys().hasAny(['auditadaPorCoordinador'])
          || data.auditadaPorCoordinador == false)
        && (!data.keys().hasAny(['bloqueada']) || data.bloqueada == false);
    }

    function validVoteTotals(data) {
      return data.votosOrganizaciones is map
        && data.votosOrganizaciones.keys().hasAll([
          'MUP', 'FCS', 'ARP', 'PDT', 'CPM'
        ])
        && data.votosOrganizaciones.keys().hasOnly([
          'MUP', 'FCS', 'ARP', 'PDT', 'CPM'
        ])
        && data.votosOrganizaciones.MUP is int
        && data.votosOrganizaciones.FCS is int
        && data.votosOrganizaciones.ARP is int
        && data.votosOrganizaciones.PDT is int
        && data.votosOrganizaciones.CPM is int
        && data.votosOrganizaciones.MUP >= 0
        && data.votosOrganizaciones.FCS >= 0
        && data.votosOrganizaciones.ARP >= 0
        && data.votosOrganizaciones.PDT >= 0
        && data.votosOrganizaciones.CPM >= 0
        && data.votosNulos is int
        && data.votosNulos >= 0
        && data.votosBlancos is int
        && data.votosBlancos >= 0
        && data.totalSufragantes is int
        && data.totalSufragantes == data.votosOrganizaciones.MUP
          + data.votosOrganizaciones.FCS
          + data.votosOrganizaciones.ARP
          + data.votosOrganizaciones.PDT
          + data.votosOrganizaciones.CPM
          + data.votosNulos
          + data.votosBlancos;
    }

    function validGps(data) {
      return data.gps is map
        && data.gps.keys().hasAll(['lat', 'lng'])
        && data.gps.lat is number
        && data.gps.lat >= -90
        && data.gps.lat <= 90
        && data.gps.lng is number
        && data.gps.lng >= -180
        && data.gps.lng <= 180;
    }

    function validClientTimestamp(data) {
      return !data.keys().hasAny(['client_timestamp'])
        || (data.client_timestamp is int
          && data.client_timestamp >= 0
          && data.client_timestamp <= request.time.toMillis() + 60000);
    }

    function isValidActa(data, actaId) {
      return data.keys().hasAll([
          'id',
          'jrvId',
          'recintoId',
          'dignidad',
          'votosOrganizaciones',
          'votosNulos',
          'votosBlancos',
          'totalSufragantes',
          'fotoPath',
          'fotoUrl',
          'gps',
          'auditadaPorCoordinador'
        ])
        && data.keys().hasOnly([
          'id',
          'jrvId',
          'recintoId',
          'dignidad',
          'votosOrganizaciones',
          'votosNulos',
          'votosBlancos',
          'totalSufragantes',
          'fotoPath',
          'fotoUrl',
          'gps',
          'auditadaPorCoordinador',
          'client_timestamp',
          'bloqueada'
        ])
        && data.id == actaId
        && data.jrvId is string
        && data.recintoId is string
        && exists(jrvPath(data.jrvId))
        && get(jrvPath(data.jrvId)).data.recintoId == data.recintoId
        && data.dignidad in ['ALCALDE', 'PREFECTO']
        && validVoteTotals(data)
        && data.fotoPath is string
        && data.fotoPath.split('/')[0] == request.auth.uid
        && data.fotoUrl is string
        && data.fotoUrl.matches('https?://.+')
        && validGps(data)
        && validClientTimestamp(data)
        && data.auditadaPorCoordinador is bool
        && (!data.keys().hasAny(['bloqueada']) || data.bloqueada is bool)
        && (!data.keys().hasAny(['bloqueada']) || data.bloqueada == false);
    }

    function canCorrectActa(data, actaId) {
      return isUnlockedActa(data)
        && data.id == actaId
        && request.resource.data.jrvId == data.jrvId
        && request.resource.data.recintoId == data.recintoId
        && request.resource.data.diff(data).affectedKeys().hasOnly([
          'votosOrganizaciones',
          'votosNulos',
          'votosBlancos',
          'totalSufragantes',
          'gps',
          'fotoPath',
          'fotoUrl',
          'auditadaPorCoordinador',
          'client_timestamp'
        ])
        && (!request.resource.data.diff(data).affectedKeys()
            .hasAny(['fotoPath', 'fotoUrl'])
          || request.resource.data.diff(data).affectedKeys()
            .hasAll(['fotoPath', 'fotoUrl']))
        && (!request.resource.data.diff(data).affectedKeys()
            .hasAny(['fotoPath'])
          || (request.resource.data.fotoPath is string
            && request.resource.data.fotoPath.split('/')[0] == request.auth.uid))
        && request.resource.data.fotoUrl is string
        && request.resource.data.fotoUrl.matches('https?://.+')
        && validClientTimestamp(request.resource.data)
        && (!request.resource.data.diff(data).affectedKeys()
            .hasAny(['auditadaPorCoordinador'])
          || (isRecinto()
            && request.resource.data.auditadaPorCoordinador == true))
        && validVoteTotals(request.resource.data)
        && validGps(request.resource.data)
        && (isRecinto() || isUnlockedActa(request.resource.data));
    }

    match /usuarios/{uid} {
      allow get: if signedIn()
        && (request.auth.uid == uid
          || isProvincial()
          || (isRecinto()
            && resource.data.rol == 'VEEDOR'
            && resource.data.recintoId == getUserData().get('recintoId', null)));

      allow list: if isProvincial()
        || (isRecinto()
          && resource.data.rol == 'VEEDOR'
          && resource.data.recintoId == getUserData().get('recintoId', null));

      allow create: if signedIn()
        && request.resource.data.id == uid
        && ((isProvincial() && request.resource.data.rol == 'RECINTO')
          || (isRecinto()
            && request.resource.data.rol == 'VEEDOR'
            && request.resource.data.recintoId == getUserData().get('recintoId', null)));

      allow update: if signedIn()
        && request.auth.uid == uid
        && resource.data.debeCambiarClave is bool
        && request.resource.data.debeCambiarClave is bool
        && resource.data.debeCambiarClave
          != request.resource.data.debeCambiarClave
        && request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly(['debeCambiarClave']);
      allow delete: if false;
    }

    match /recintos/{recintoId} {
      allow get, list: if isProvincial()
        || (isRecinto()
          && recintoId == getUserData().get('recintoId', null));
      allow create, update, delete: if isProvincial();
    }

    match /jrvs/{jrvId} {
      allow get, list: if isProvincial()
        || (isRecinto()
          && resource.data.recintoId == getUserData().get('recintoId', null))
        || (isVeedor() && resource.data.veedorId == request.auth.uid);

      allow create, delete: if isProvincial();

      allow update: if isProvincial()
        || (isRecinto()
          && resource.data.recintoId == getUserData().get('recintoId', null)
          && request.resource.data.recintoId == resource.data.recintoId
          && request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(['veedorId'])
          && (!request.resource.data.keys().hasAny(['veedorId'])
            || request.resource.data.veedorId == null
            || isVeedorOfRecinto(
              request.resource.data.veedorId,
              resource.data.recintoId
            )));
    }

    match /organizaciones/{organizacionId} {
      allow read, write: if isProvincial();
    }

    match /candidatos/{candidatoId} {
      allow read, write: if isProvincial();
    }

    match /actas/{actaId} {
      allow get, list: if isProvincial()
        || canReadActaInRecinto(resource.data)
        || canReadActaAsVeedor(resource.data);

      allow create: if isProvincial()
        || (isVeedor()
          && isValidActa(request.resource.data, actaId)
          && isUnlockedActa(request.resource.data)
          && isAssignedVeedor(request.resource.data.jrvId));

      allow update: if isProvincial()
        || (isRecinto()
          && canReadActaInRecinto(resource.data)
          && canCorrectActa(resource.data, actaId))
        || (isVeedor()
          && isAssignedVeedor(resource.data.jrvId)
          && canCorrectActa(resource.data, actaId));

      allow delete: if isProvincial();
    }

    match /cedulas_lookup/{cedula} {
      allow get: if !exists(
          /databases/$(database)/documents/cedulas_lookup/$(cedula)
        )
        || (resource.data.keys().hasAll(['email', 'uid'])
          && resource.data.keys().hasOnly(['email', 'uid'])
          && resource.data.email is string
          && resource.data.uid is string);
      allow create: if signedIn() && canCreateCedulaLookup(cedula);
      allow list, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
